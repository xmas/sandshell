#!/bin/sh
# berg kit, at each start: berg from the hub when it's missing (or with
# --update). Never fails the sandbox's start: it says what's wrong instead.
#
#   berg-kit-setup            what runs at start
#   berg-kit-setup --update   fetch berg again (the hub's current one)
set -u
say() { printf '[berg kit] %s\n' "$*" >&2; }
bin="$HOME/.local/bin"
mkdir -p "$bin"

# --- berg from the hub, with the token sbx's proxy puts on the request
install_berg() {
  hub="${BERG_HUB_URL:-}"
  if [ -z "$hub" ]; then say "no hub set (the kit's hub argument): berg not installed"; return; fi
  if [ -z "${BERG_TOKEN:-}" ]; then
    say "no BERG_TOKEN: give sbx your berg token for the hub's host (Sandshell: Settings ▸ Kits ▸ berg)"
    return
  fi
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) say "no berg build for $(uname -m)"; return ;;
  esac
  tmp="$bin/.berg.$$"
  code=$(curl -sS -o "$tmp" -w '%{http_code}' -H "Authorization: Bearer $BERG_TOKEN" \
    "${hub%/}/api/v1/download/berg/linux-$arch" 2>/dev/null) || code=000
  if [ "$code" = 200 ] && [ -s "$tmp" ]; then
    chmod 0755 "$tmp" && mv -f "$tmp" "$bin/berg" && say "$("$bin/berg" --version 2>/dev/null || echo berg) from $hub"
  else
    rm -f "$tmp"
    case "$code" in
      401) say "the hub refused the token (HTTP 401): give sbx a current berg token for its host" ;;
      404) say "the hub has no berg download for tokens yet (HTTP 404): it needs Iceberg's /api/v1/download/berg route" ;;
      000) say "can't reach $hub from the sandbox" ;;
      *) say "berg download failed (HTTP $code) from $hub" ;;
    esac
  fi
}
if [ "${1:-}" = "--update" ] || ! [ -x "$bin/berg" ]; then install_berg; fi

exit 0
