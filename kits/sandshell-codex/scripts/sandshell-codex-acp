#!/bin/sh
# Sandshell's Codex chat entry point: the ACP adapter on stdio. NO_BROWSER
# hides the ChatGPT browser login, which can't work in a sandbox.
set -e
export PATH="/opt/sandshell/bin:$PATH"
export NO_BROWSER=1
exec /opt/sandshell/bin/node /opt/sandshell/codex-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js "$@"
